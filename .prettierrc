{
  "trailingComma": "none",
  "endOfLine": "auto",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "semi": true,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "bracketSameLine": true,
  "overrides": [
    {
      "files": ".sequelizerc",
      "options": {
        "parser": "babel"
      }
    }
  ]
}
