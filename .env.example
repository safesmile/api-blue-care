NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blue_dent
DB_USER=blue_dent
DB_PASSWORD=replace-me
DB_SSL=false
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=604800
SESSION_MAX_SECONDS=2592000
# Optional. ADC locally and attached service identity in Cloud Run.
GOOGLE_CLOUD_PROJECT=
GCS_PRIVATE_BUCKET=
# JSON secret with string values; explicit environment variables take precedence.
# projects/PROJECT/secrets/blue-dent-config/versions/latest
GCP_CONFIG_SECRET=
EMAIL_PROVIDER=smtp
SENDGRID_API_KEY=
SMTP_REQUIRE_TLS=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Blue Care <no-reply@blue-dent.test>
FRONTEND_URL=http://localhost:5173

# Local Mailpit web UI port; SMTP_PORT above also controls the host SMTP port.
MAILPIT_UI_PORT=8025

# Optional ADC key file; prefer gcloud auth application-default login locally.
# Leave unset in Cloud Run (attached runtime service identity).
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside-repo/service-account.json
GCP_JOBS_ENABLED=false
GCP_LOCATION=us-central1
GCP_TASKS_QUEUE=blue-care-notifications
GCP_CALLBACK_URL=
GCP_JOBS_AUDIENCE=
GCP_JOBS_SERVICE_ACCOUNT=
GCP_NOTIFICATION_SCHEDULE_ID=blue-care-notifications-sweep
GCP_NOTIFICATION_SCHEDULE=* * * * *
GCP_SCHEDULER_TIME_ZONE=America/Guatemala
NOTIFICATION_MAX_ATTEMPTS=5

# Hosted recurring card checkout. Disabled until a named Recurrente Sandbox is configured.
RECURRENTE_ENABLED=false
RECURRENTE_MODE=test
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
GCP_MEMBERSHIP_SCHEDULE_ID=blue-care-memberships-sweep
GCP_MEMBERSHIP_SCHEDULE=* * * * *

# Push: Firebase Cloud Messaging HTTP v1, authenticated with the existing Google ADC.
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
# Explicit scheduler provisioning: npm run gcp:scheduler:sync -- --prevention
GCP_PREVENTION_SCHEDULE_ID=blue-care-prevention-sweep
GCP_PREVENTION_SCHEDULE=* * * * *

# Shared HTML email identity (read after environment/Secret Manager initialization).
EMAIL_APP_NAME=Blue Care
EMAIL_PRIMARY_COLOR="#1469b8"
# Optional absolute public logo URL. No logo is required for the default text wordmark.
EMAIL_LOGO_URL=
EMAIL_SUPPORT_EMAIL=
