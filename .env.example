NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blue_dent
DB_USER=blue_dent
DB_PASSWORD=replace-me
DB_SSL=false
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=604800
SESSION_MAX_SECONDS=2592000
# Optional. ADC locally and attached service identity in Cloud Run.
GOOGLE_CLOUD_PROJECT=
GCS_PRIVATE_BUCKET=
# JSON secret with string values; explicit environment variables take precedence.
# projects/PROJECT/secrets/blue-dent-config/versions/latest
GCP_CONFIG_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Blue Dent <no-reply@blue-dent.test>
FRONTEND_URL=http://localhost:5173

# Local Mailpit web UI port; SMTP_PORT above also controls the host SMTP port.
MAILPIT_UI_PORT=8025
