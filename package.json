{
  "name": "api-blue-dent",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"{src,scripts,database}/**/*.{ts,cjs,json}\" eslint.config.mjs .prettierrc docker/docker-compose.yaml",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,scripts,database}/**/*.{ts,cjs}\" eslint.config.mjs --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npm run test:integration",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "lint:check": "eslint \"{src,scripts,database}/**/*.{ts,cjs}\" eslint.config.mjs",
    "test:integration": "node scripts/test-integration.cjs",
    "format:check": "prettier --check \"{src,scripts,database}/**/*.{ts,cjs,json}\" eslint.config.mjs .prettierrc docker/docker-compose.yaml",
    "test:typecheck": "tsc --noEmit --incremental false",
    "permissions": "node scripts/update-permissions.cjs",
    "createSuperUser": "node scripts/createSuperUser.cjs",
    "db:migrate:reset": "sequelize-cli db:migrate:undo:all && npm run db:migrate && npm run db:seed",
    "db:seed": "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.2.0",
    "@google-cloud/storage": "^8.4.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/sequelize": "^11.0.1",
    "@nestjs/throttler": "^6.7.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-spellcheck": "^0.0.20",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "modules/**/application/**/*.ts",
      "modules/**/presentation/*controller.ts",
      "app.controller.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 80,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "^2.5.0"
    }
  }
}
